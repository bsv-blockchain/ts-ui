/packages/amountinator-react/NOTICE
/packages/brc100-ui-react/LICENSE
/packages/brc100-ui-react/NOTICE
/packages/btms-permission-module-ui/LICENSE
/packages/btms-permission-module-ui/NOTICE
/packages/identity-react/LICENSE
/packages/identity-react/NOTICE
/packages/metanet-apps/LICENSE
/packages/metanet-apps/NOTICE
/packages/uhrp-react/LICENSE
/packages/uhrp-react/NOTICE
