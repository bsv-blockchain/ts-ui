node_modules/
dist/
build/
*.tsbuildinfo

# pnpm is the only package manager here; npm/yarn lockfiles are subtree-merge
# leftovers and each one multiplies Dependabot alerts
package-lock.json
yarn.lock
.env
.env.*
!.env.example
coverage/
.nyc_output/
*.log
.DS_Store

# LICENSE / NOTICE copied into nested npm packages by their prepack script
